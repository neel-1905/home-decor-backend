  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "bun x drizzle-kit generate",
    "db:migrate": "bun x drizzle-kit migrate",
    "db:push": "bun x drizzle-kit push",
    "db:pull": "bun x drizzle-kit pull",
    "db:studio": "bun x drizzle-kit studio",
    "seed:rbac": "bun run src/db/seed/rbac.seed.ts",
    "seed:reset": "bun run src/db/seed/reset.seed.ts",
    "seed:catalog": "bun run src/db/seed/catalog.seed.ts"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.5",
    "@nestjs/common": "^12.0.1",
